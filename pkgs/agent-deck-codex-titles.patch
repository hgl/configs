+// Codex appends both generated names and /rename edits to session_index.jsonl.
+// The last complete record for the exact thread wins; neither cwd nor the
+// terminal title identifies a conversation when several sessions share a repo.
+func codexSessionNameIn(home, sessionID string) string {
+	if home == "" || sessionID == "" {
+		return ""
+	}
+	data, err := os.ReadFile(filepath.Join(home, "session_index.jsonl"))
+	if err != nil {
+		return ""
+	}
+	name := ""
+	for _, line := range bytes.SplitAfter(data, []byte{'\n'}) {
+		// A writer may be partway through appending the final record.
+		if len(line) == 0 || line[len(line)-1] != '\n' {
+			continue
+		}
+		var entry struct {
+			ID   string `json:"id"`
+			Name string `json:"thread_name"`
+		}
+		if json.Unmarshal(line, &entry) == nil && entry.ID == sessionID {
+			name = entry.Name
+		}
+	}
+	// Names are displayed in terminal chrome: never emit control sequences.
+	name = strings.Map(func(r rune) rune {
+		if unicode.IsControl(r) {
+			return ' '
+		}
+		return r
+	}, name)
+	return strings.Join(strings.Fields(name), " ")
+}
+
+// ReconcileTitleFromCodex persists only the title, preserving concurrent edits
+// and respecting Agent Deck's explicit title lock. Called after status polling
+// has resolved the current conversation, including hook/process identity changes.
+func (i *Instance) ReconcileTitleFromCodex() {
+	if i == nil {
+		return
+	}
+	i.mu.RLock()
+	if !IsCodexCompatible(i.Tool) || i.TitleLocked || i.SSHHost != "" {
+		i.mu.RUnlock()
+		return
+	}
+	sid, title, home := i.CodexSessionID, i.Title, i.getCodexHomeDir()
+	i.mu.RUnlock()
+	if sid == "" {
+		return
+	}
+	if cfg, err := LoadUserConfig(); err != nil || (cfg != nil && !cfg.GetSyncTitle()) {
+		return
+	}
+	name := codexSessionNameIn(home, sid)
+	if name == "" || name == title {
+		return
+	}
+	db := i.restartDB.Load()
+	if db == nil {
+		return
+	}
+	i.mu.Lock()
+	if i.TitleLocked || i.CodexSessionID != sid || i.Title != title {
+		i.mu.Unlock()
+		return
+	}
+	applied, err := db.UpdateTitleIfUnlocked(i.ID, name)
+	if err != nil || !applied {
+		i.mu.Unlock()
+		return
+	}
+	i.Title, i.AutoName = name, false
+	i.mu.Unlock()
+	_ = db.Touch() // Wake existing TUI/remote registry watchers.
+	i.SyncTmuxDisplayName()
+	if ts := i.GetTmuxSession(); ts != nil && ts.Name != "" {
+		_ = tmux.WriteBadgeUpdate(ts.Name, name)
+	}
+}
+
+// WatchCodexTitle covers direct CLI/SSH attachment, which has no TUI status
+// loop. Load a fresh instance per tick so a rename, lock or /new cannot leave
+// the attach process using its initial snapshot. No agent process is restarted.
+func WatchCodexTitle(ctx context.Context, profile, instanceID string) {
+	storage, err := NewStorageWithProfile(profile)
+	if err != nil {
+		return
+	}
+	defer storage.Close()
+	ticker := time.NewTicker(2 * time.Second)
+	defer ticker.Stop()
+	for {
+		instances, _, err := storage.LoadWithGroups()
+		if err == nil {
+			for _, inst := range instances {
+				if inst.ID == instanceID {
+					// UpdateStatus resolves live identity before reconciling names.
+					_ = inst.UpdateStatus()
+					break
+				}
+			}
+		}
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+	}
+}
