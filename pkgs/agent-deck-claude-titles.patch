+++ b/internal/session/claude_conversation_title_test.go
@@ -0,0 +1,100 @@
+package session
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestClaudeTranscriptTitles(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "session.jsonl")
+	data := "{\"type\":\"ai-title\",\"sessionId\":\"ours\",\"aiTitle\":\"Generated title\"}\n" +
+		strings.Repeat("x", 150000) + "\n" +
+		"{\"type\":\"ai-title\",\"sessionId\":\"other\",\"aiTitle\":\"Wrong session\"}\n" +
+		"{\"type\":\"custom-title\",\"sessionId\":\"ours\",\"customTitle\":\"Manual rename\"}"
+	if err := os.WriteFile(path, []byte(data), 0600); err != nil {
+		t.Fatal(err)
+	}
+	custom, generated := claudeTranscriptTitles(path, "ours")
+	if custom != "" || generated != "Generated title" {
+		t.Fatalf("titles = %q, %q", custom, generated)
+	}
+	file, err := os.OpenFile(path, os.O_APPEND|os.O_WRONLY, 0600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = file.WriteString("\n{\"type\":\"ai-title\",\"sessionId\":\"ours\",\"aiTitle\":\"Later generated title\"}\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	file.Close()
+	custom, generated = claudeTranscriptTitles(path, "ours")
+	if custom != "Manual rename" || generated != "Later generated title" {
+		t.Fatalf("append = %q, %q", custom, generated)
+	}
+	// A compacted file replaces its inode and can lose obsolete metadata.
+	replacement := path + ".tmp"
+	if err := os.WriteFile(replacement, []byte("{\"type\":\"ai-title\",\"sessionId\":\"ours\",\"aiTitle\":\"Compacted title\"}\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Rename(replacement, path); err != nil {
+		t.Fatal(err)
+	}
+	custom, generated = claudeTranscriptTitles(path, "ours")
+	if custom != "" || generated != "Compacted title" {
+		t.Fatalf("replacement = %q, %q", custom, generated)
+	}
+}
+
+func TestReconcileGeneratedClaudeTitle(t *testing.T) {
+	startupNameConfig(t, "")
+	home := os.Getenv("HOME")
+	project := t.TempDir()
+	transcripts := filepath.Join(home, ".claude", "projects", ConvertToClaudeDirName(project))
+	if err := os.MkdirAll(transcripts, 0700); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(transcripts, "native-session.jsonl")
+	if err := os.WriteFile(path, []byte("{\"type\":\"ai-title\",\"sessionId\":\"native-session\",\"aiTitle\":\"Why the sky is blue\"}\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	// This is what real Claude writes: registry remains derived, generated
+	// conversation title lives only in the transcript.
+	seedClaudeSessionFile(t, home, "1234.json", map[string]any{"sessionId": "native-session", "name": "project-ab", "nameSource": "derived"})
+	storage := newTestStorage(t)
+	inst := NewInstance("forest-fern", project)
+	inst.Tool, inst.Command, inst.ClaudeSessionID, inst.AutoName = "claude", "claude", "native-session", true
+	if err := storage.SaveWithGroups([]*Instance{inst}, nil); err != nil {
+		t.Fatal(err)
+	}
+	inst.ReconcileSessionTitle()
+	rows, _, err := storage.LoadWithGroups()
+	if err != nil || len(rows) != 1 || rows[0].Title != "Why the sky is blue" || !rows[0].AutoName || rows[0].TitleLocked {
+		t.Fatalf("generated title = %+v, err=%v", rows, err)
+	}
+	if name := rows[0].ClaudeLaunchName(); name != "" {
+		t.Fatalf("restart would pin generated name: %q", name)
+	}
+	// Explicit Claude renames override AI titles and stop automatic naming.
+	seedClaudeSession(t, home, "native-session", "User renamed title")
+	inst.ReconcileSessionTitle()
+	if inst.Title != "User renamed title" || inst.AutoName {
+		t.Fatalf("rename = %q auto=%v", inst.Title, inst.AutoName)
+	}
+	// Neither generated title sync nor a stale snapshot can replace a DB lock.
+	rows, _, err = storage.LoadWithGroups()
+	if err != nil {
+		t.Fatal(err)
+	}
+	rows[0].Title, rows[0].TitleLocked = "Pinned", true
+	if err := storage.SaveWithGroups(rows, nil); err != nil {
+		t.Fatal(err)
+	}
+	seedClaudeSessionFile(t, home, "1234.json", map[string]any{"sessionId": "native-session", "name": "project-ab", "nameSource": "derived"})
+	inst.ReconcileSessionTitle()
+	rows, _, err = storage.LoadWithGroups()
+	if err != nil || rows[0].Title != "Pinned" {
+		t.Fatalf("lost pin: %+v %v", rows, err)
+	}
+}
