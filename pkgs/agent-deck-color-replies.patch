+package termreply
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAttachedFilterPreservesDefaultPalette(t *testing.T) {
+	for _, reply := range []string{
+		"\x1b]10;rgb:aaaa/bbbb/cccc\x07",
+		"\x1b]11;rgb:12/34/56\x1b\\",
+	} {
+		for _, armed := range []bool{true, false} {
+			for split := 2; split <= len(reply); split++ {
+				f := Filter{PreserveColorReplies: true}
+				got := f.Consume([]byte(reply[:split]), armed, false)
+				got = append(got, f.Consume([]byte(reply[split:]+"x"), armed, false)...)
+				require.Equal(t, reply+"x", string(got))
+				require.False(t, f.Active())
+			}
+		}
+		var drain Filter
+		require.Equal(t, "x", string(drain.Consume([]byte(reply+"x"), true, false)))
+	}
+}
+
+func TestAttachedFilterStillDiscardsOtherReplies(t *testing.T) {
+	for _, reply := range []string{
+		"\x1b]52;c;secret\x07",
+		"\x1b]11;rgb:nope\x07",
+		"\x1b]11;rgb:12345/0/0\x07",
+		"\x1b]11;rgb:1/2/3/4\x1b\\",
+		"\x1b]11;" + strings.Repeat("x", 1000) + "\x1b\\",
+		"\x1bP>|iTerm2 3.6.10n\x1b\\",
+	} {
+		f := Filter{PreserveColorReplies: true}
+		require.Equal(t, "x", string(f.Consume([]byte(reply+"x"), false, false)))
+		require.False(t, f.Active())
+	}
+	f := Filter{PreserveColorReplies: true}
+	require.Empty(t, f.Consume([]byte("\x1b]11;rgb:1234"), true, true))
+	require.False(t, f.Active())
+}
