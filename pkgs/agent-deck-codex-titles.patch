+package session
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestCodexSessionNameIn(t *testing.T) {
+	home := t.TempDir()
+	path := filepath.Join(home, "session_index.jsonl")
+	data := "{\"id\":\"one\",\"thread_name\":\"Generated task title\"}\n" +
+		"not json\n" +
+		"{\"id\":\"other\",\"thread_name\":\"Wrong conversation\"}\n" +
+		"{\"id\":\"one\",\"thread_name\":\"  Renamed task\\n标题  \"}\n" +
+		"{\"id\":\"one\",\"thread_name\":\"Partial append\"}"
+	if err := os.WriteFile(path, []byte(data), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if got := codexSessionNameIn(home, "one"); got != "Renamed task 标题" {
+		t.Fatalf("name = %q", got)
+	}
+	if got := codexSessionNameIn(home, "unknown"); got != "" {
+		t.Fatalf("unknown = %q", got)
+	}
+	if err := os.WriteFile(path, []byte(data+"\n{\"id\":\"one\",\"thread_name\":\"\"}\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if got := codexSessionNameIn(home, "one"); got != "" {
+		t.Fatalf("cleared = %q", got)
+	}
+}
+
+func TestReconcileTitleFromCodex(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("CODEX_HOME", home)
+	path := filepath.Join(home, "session_index.jsonl")
+	writeName := func(name string) {
+		t.Helper()
+		if err := os.WriteFile(path, []byte("{\"id\":\"thread-one\",\"thread_name\":\""+name+"\"}\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	storage := newTestStorage(t)
+	inst := NewInstance("random-fox", t.TempDir())
+	inst.Tool, inst.Command = "codex", "codex"
+	inst.CodexSessionID, inst.AutoName = "thread-one", true
+	if err := storage.SaveWithGroups([]*Instance{inst}, nil); err != nil {
+		t.Fatal(err)
+	}
+	writeName("Generated task title")
+	// Even a stopped session must get its name when status is queried.
+	_ = inst.UpdateStatus()
+	if inst.Title != "Generated task title" || inst.AutoName || inst.TitleLocked {
+		t.Fatalf("sync failed: title=%q auto=%v locked=%v", inst.Title, inst.AutoName, inst.TitleLocked)
+	}
+	writeName("Manual Codex rename")
+	inst.ReconcileTitleFromCodex()
+	rows, _, err := storage.LoadWithGroups()
+	if err != nil || len(rows) != 1 || rows[0].Title != "Manual Codex rename" || rows[0].CodexSessionID != "thread-one" {
+		t.Fatalf("persisted rename = %+v, err=%v", rows, err)
+	}
+	// A concurrent Agent Deck rename locks the stored row after our snapshot.
+	rows[0].Title, rows[0].TitleLocked = "Pinned by user", true
+	if err := storage.SaveWithGroups(rows, nil); err != nil {
+		t.Fatal(err)
+	}
+	writeName("Must not overwrite pinned title")
+	inst.ReconcileTitleFromCodex()
+	rows, _, err = storage.LoadWithGroups()
+	if err != nil || rows[0].Title != "Pinned by user" {
+		t.Fatalf("lost title lock: %+v %v", rows, err)
+	}
+	if inst.Title != "Manual Codex rename" {
+		t.Fatal("rejected write changed in-memory title")
+	}
+	// A configured opt-out must also apply to unlocked sessions.
+	rows[0].TitleLocked = false
+	if err := storage.SaveWithGroups(rows, nil); err != nil {
+		t.Fatal(err)
+	}
+	configPath, err := GetUserConfigPath()
+	if err != nil {
+		t.Fatal(err)
+	}
+	oldConfig, readErr := os.ReadFile(configPath)
+	t.Cleanup(func() {
+		if readErr == nil {
+			_ = os.WriteFile(configPath, oldConfig, 0600)
+		} else {
+			_ = os.Remove(configPath)
+		}
+		ClearUserConfigCache()
+	})
+	if err := os.MkdirAll(filepath.Dir(configPath), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(configPath, []byte("sync_title = false\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	ClearUserConfigCache()
+	rows[0].ReconcileTitleFromCodex()
+	if rows[0].Title != "Pinned by user" {
+		t.Fatal("sync_title=false was ignored")
+	}
+}
