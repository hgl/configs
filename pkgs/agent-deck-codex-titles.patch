+func TestReconcileTitleFromCodexUsesSessionHome(t *testing.T) {
+	home, wrongHome := t.TempDir(), t.TempDir()
+	t.Setenv("CODEX_HOME", wrongHome)
+	for dir, name := range map[string]string{home: "Right account", wrongHome: "Wrong account"} {
+		if err := os.WriteFile(filepath.Join(dir, "session_index.jsonl"), []byte("{\"id\":\"thread\",\"thread_name\":\""+name+"\"}\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	storage := newTestStorage(t)
+	inst := NewInstance("random-fox", t.TempDir())
+	inst.Tool, inst.Command, inst.CodexSessionID = "codex", "CODEX_HOME="+home+" codex", "thread"
+	if err := storage.SaveWithGroups([]*Instance{inst}, nil); err != nil {
+		t.Fatal(err)
+	}
+	inst.ReconcileTitleFromCodex()
+	if inst.Title != "Right account" {
+		t.Fatalf("title = %q", inst.Title)
+	}
+}
