+package session
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestReconcileSessionTitleClaudeAccount(t *testing.T) {
+	account := t.TempDir()
+	configPath := startupNameConfig(t, fmt.Sprintf("[profiles.work.claude]\nconfig_dir=%q\n", filepath.Join(account, ".claude")))
+	seedClaudeSession(t, os.Getenv("HOME"), "thread", "Wrong account")
+	seedClaudeSession(t, account, "thread", "Generated title")
+	storage := newTestStorage(t)
+	inst := NewInstance("random-fox", t.TempDir())
+	inst.Tool, inst.Command, inst.Account = "claude", "claude", "work"
+	inst.ClaudeSessionID, inst.AutoName = "thread", true
+	if err := storage.SaveWithGroups([]*Instance{inst}, nil); err != nil {
+		t.Fatal(err)
+	}
+	// The account-aware resolver is shared by hooks and on-attach sync.
+	if name, changed := inst.ResolveTitleFromClaude("thread"); !changed || name != "Generated title" {
+		t.Fatalf("resolved = %q, %v", name, changed)
+	}
+	// Stopped and idle sessions are included in ordinary status reconciliation.
+	_ = inst.UpdateStatus()
+	if inst.Title != "Generated title" || inst.AutoName || inst.TitleLocked {
+		t.Fatalf("sync = %q, auto=%v, locked=%v", inst.Title, inst.AutoName, inst.TitleLocked)
+	}
+	seedClaudeSession(t, account, "thread", "Renamed 标题")
+	inst.ReconcileSessionTitle()
+	rows, _, err := storage.LoadWithGroups()
+	if err != nil || len(rows) != 1 || rows[0].Title != "Renamed 标题" || rows[0].ClaudeSessionID != "thread" {
+		t.Fatalf("persisted = %+v, err=%v", rows, err)
+	}
+	// A concurrent Agent Deck rename must protect the DB and terminal chrome.
+	rows[0].Title, rows[0].TitleLocked = "Pinned by user", true
+	if err := storage.SaveWithGroups(rows, nil); err != nil {
+		t.Fatal(err)
+	}
+	seedClaudeSession(t, account, "thread", "Must not overwrite pinned title")
+	inst.ReconcileSessionTitle()
+	rows, _, err = storage.LoadWithGroups()
+	if err != nil || rows[0].Title != "Pinned by user" || inst.Title != "Renamed 标题" {
+		t.Fatalf("lost title lock: %+v %v, memory=%q", rows, err, inst.Title)
+	}
+	rows[0].TitleLocked = false
+	if err := storage.SaveWithGroups(rows, nil); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(configPath, []byte(fmt.Sprintf("sync_title=false\n[profiles.work.claude]\nconfig_dir=%q\n", filepath.Join(account, ".claude"))), 0600); err != nil {
+		t.Fatal(err)
+	}
+	ClearUserConfigCache()
+	rows[0].ReconcileSessionTitle()
+	if rows[0].Title != "Pinned by user" {
+		t.Fatal("sync_title=false ignored")
+	}
+}
+
+func TestReconcileSessionTitleClaudeBoundaries(t *testing.T) {
+	startupNameConfig(t, "")
+	home := os.Getenv("HOME")
+	seedClaudeSession(t, home, "other-thread", "Unrelated conversation")
+	storage := newTestStorage(t)
+	inst := NewInstance("random-fox", t.TempDir())
+	inst.Tool, inst.Command, inst.ClaudeSessionID = "claude", "claude", "thread"
+	if err := storage.SaveWithGroups([]*Instance{inst}, nil); err != nil {
+		t.Fatal(err)
+	}
+	inst.ReconcileSessionTitle()
+	if inst.Title != "random-fox" {
+		t.Fatal("selected wrong session")
+	}
+	seedClaudeSession(t, home, "thread", "Local name")
+	inst.SSHHost = "remote"
+	inst.ReconcileSessionTitle()
+	if inst.Title != "random-fox" {
+		t.Fatal("read local metadata for a remote session")
+	}
+	inst.SSHHost = ""
+	seedClaudeSessionFile(t, home, "1234.json", map[string]any{"sessionId": "thread", "name": "folder-name", "nameSource": "derived"})
+	inst.ReconcileSessionTitle()
+	if inst.Title != "random-fox" {
+		t.Fatal("adopted a folder-derived name")
+	}
+	seedClaudeSession(t, home, "thread", "unsafe\x1b]2;title\x07")
+	inst.ReconcileSessionTitle()
+	if inst.Title != "random-fox" {
+		t.Fatal("accepted terminal control characters")
+	}
+}
