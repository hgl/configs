+// isDefaultColorReply accepts only OSC 10/11 RGB replies, not arbitrary OSC
+// payloads. The caller supplies the payload without its introducer/terminator.
+func isDefaultColorReply(payload []byte) bool {
+	s := string(payload)
+	if !strings.HasPrefix(s, "10;rgb:") && !strings.HasPrefix(s, "11;rgb:") {
+		return false
+	}
+	parts := strings.Split(s[7:], "/")
+	if len(parts) != 3 {
+		return false
+	}
+	for _, part := range parts {
+		if len(part) < 1 || len(part) > 4 {
+			return false
+		}
+		for _, c := range part {
+			if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F') {
+				return false
+			}
+		}
+	}
+	return true
 }
 
