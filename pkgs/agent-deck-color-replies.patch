+func TestAttachStdinPump_ForwardsDefaultColors(t *testing.T) {
+	for _, quarantine := range []bool{true, false} {
+		t.Run(fmt.Sprint(quarantine), func(t *testing.T) {
+			pump, w, out := newTestPump(t, AttachOptions{DetachByte: 17})
+			if quarantine {
+				pump.startTime = time.Now()
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			done := runPump(ctx, pump)
+			colors := "\x1b]10;rgb:aaaa/bbbb/cccc\a\x1b]11;rgb:1111/2222/3333\x1b\\"
+			// Tmux consumes color replies. Unrelated strings must still be
+			// stripped, and the detach key must retain its normal behavior.
+			if _, err := w.Write([]byte(colors + "\x1bP>|terminal version\x1b\\x\x11")); err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case res := <-done:
+				if !res.interrupted {
+					t.Fatal("detach key did not interrupt attach")
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("pump did not exit on detach")
+			}
+			if got := out.String(); got != colors+"x" {
+				t.Errorf("forwarded %q, want %q", got, colors+"x")
+			}
+		})
+	}
+}
