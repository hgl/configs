diff --git a/internal/session/claude_conversation_title.go b/internal/session/claude_conversation_title.go
new file mode 100644
index 0000000..e91dc74
--- /dev/null
+++ b/internal/session/claude_conversation_title.go
@@ -0,0 +1,99 @@
+package session
+
+import (
+	"bufio"
+	"encoding/json"
+	"io"
+	"os"
+	"sync"
+)
+
+// Claude's generated name lives in the transcript's ai-title record. Its
+// per-process registry can continue to report a folder-derived name instead.
+// Explicit /rename names still take precedence over the generated name.
+func claudeConversationTitleIn(home, projectPath, sessionID string) (string, bool) {
+	if name := ClaudeSessionNameIn(home, sessionID); name != "" {
+		return name, false
+	}
+	path := resolveClaudeTranscriptPath(home, projectPath, sessionID)
+	custom, generated := claudeTranscriptTitles(path, sessionID)
+	if custom != "" {
+		return custom, false
+	}
+	return generated, generated != ""
+}
+
+type claudeTitleCursor struct {
+	info              os.FileInfo
+	offset            int64
+	custom, generated string
+}
+
+var claudeTitleCache = struct {
+	sync.Mutex
+	entries map[string]claudeTitleCursor
+}{entries: make(map[string]claudeTitleCursor)}
+
+// Read only new, complete JSONL records. Large tool results are discarded in
+// bounded chunks, and an incomplete append is retried next time. Compaction
+// replaces/truncates the file, so its inode/size reset the cursor and names.
+func claudeTranscriptTitles(path, sessionID string) (string, string) {
+	if path == "" || sessionID == "" {
+		return "", ""
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return "", ""
+	}
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil {
+		return "", ""
+	}
+	claudeTitleCache.Lock()
+	defer claudeTitleCache.Unlock()
+	key := path + "\x00" + sessionID
+	cursor := claudeTitleCache.entries[key]
+	if cursor.info == nil || !os.SameFile(cursor.info, info) || info.Size() < cursor.offset ||
+		(info.Size() == cursor.info.Size() && !info.ModTime().Equal(cursor.info.ModTime())) {
+		cursor = claudeTitleCursor{}
+	}
+	if _, err := file.Seek(cursor.offset, io.SeekStart); err != nil {
+		return "", ""
+	}
+	reader := bufio.NewReaderSize(file, 64*1024)
+	var skipped int64
+	for {
+		line, err := reader.ReadSlice('\n')
+		if err == bufio.ErrBufferFull {
+			skipped += int64(len(line))
+			continue
+		}
+		if err != nil { // Do not consume a partially appended final record.
+			break
+		}
+		cursor.offset += skipped + int64(len(line))
+		if skipped != 0 {
+			skipped = 0
+			continue
+		}
+		var entry struct {
+			Type        string `json:"type"`
+			SessionID   string `json:"sessionId"`
+			CustomTitle string `json:"customTitle"`
+			AITitle     string `json:"aiTitle"`
+		}
+		if json.Unmarshal(line, &entry) != nil || entry.SessionID != sessionID {
+			continue
+		}
+		switch entry.Type {
+		case "custom-title":
+			cursor.custom = claudeTitleName(entry.CustomTitle)
+		case "ai-title":
+			cursor.generated = claudeTitleName(entry.AITitle)
+		}
+	}
+	cursor.info = info
+	claudeTitleCache.entries[key] = cursor
+	return cursor.custom, cursor.generated
+}
diff --git a/internal/session/claude_conversation_title_test.go b/internal/session/claude_conversation_title_test.go
new file mode 100644
index 0000000..1e17471
